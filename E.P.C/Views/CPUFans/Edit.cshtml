@model E.P.C.Models.CPUFan

@{
    ViewData["Title"] = "Edit CPU Fan";
}

<div class="edit-form-container">
    <h1>Edit CPU Fan</h1>
    <hr />
    <form asp-action="Edit" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />
        <div class="form-grid">
            <div class="form-group">
                <label>Brand</label>
                <input asp-for="Brand" class="form-control" />
            </div>
            <div class="form-group">
                <label>Model</label>
                <input asp-for="Model" class="form-control" />
            </div>
            <div class="form-group">
                <label>Size (mm)</label>
                <input asp-for="Size" class="form-control" type="number" />
            </div>
            <div class="form-group">
                <label>RPM</label>
                <input asp-for="RPM" class="form-control" type="number" />
            </div>
            <div class="form-group">
                <label>Airflow (CFM)</label>
                <input asp-for="Airflow" class="form-control" type="number" step="0.1" />
            </div>
            <div class="form-group">
                <label>Noise Level (dBA)</label>
                <input asp-for="NoiseLevel" class="form-control" type="number" />
            </div>
            <div class="form-group">
                <label>Connector Type</label>
                <input asp-for="ConnectorType" class="form-control" />
            </div>
            <div class="form-group">
                <label>Description</label>
                <input asp-for="Description" class="form-control" />
            </div>
            <div class="form-group">
                <label>Price (₪)</label>
                <input asp-for="Price" class="form-control" />
            </div>
            <div class="form-group">
                <label>Image URL</label>
                <input asp-for="ImageUrl" class="form-control" />
            </div>
        </div>
        <div class="form-group mt-3">
            <label>Supported Sockets</label>
            <div class="socket-checkboxes">
                @{
                    var selected = Model.SupportedSockets?.Split(',', System.StringSplitOptions.RemoveEmptyEntries)
                    .Select(s => s.Trim()).ToList() ?? new List<string>();
                    var sockets = new List<string> {
                                "LGA1155", "LGA1156", "LGA1150", "LGA1151", "LGA1200", "LGA1700", "LGA1851",
                                "LGA2011", "LGA2011-v3", "LGA2066", "LGA3647", "LGA4189", "LGA4677",
                                "AM3+", "FM2+", "AM4", "AM5",
                                "sTR4", "sTRX4", "sWRX8", "sTR5"
                                };
                }
                @foreach (var socket in sockets)
                {
                    var isChecked = selected.Contains(socket);
                    <label class="socket-label">
                        <input type="checkbox" name="SupportedSockets" value="@socket" @(isChecked ? "checked" : "") />
                        <span>@socket</span>
                    </label>
                }
            </div>
        </div>
        <div class="form-group mt-4">
            <input type="submit" value="Save Changes" />
        </div>
    </form>
    <div class="mt-3">
        <a asp-controller="Products" asp-action="Index">← Back to Products</a>
    </div>
</div>

<style>
    .edit-form-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 40px;
        background: rgba(10,15,26,0.95);
        border-radius: 18px;
        border: 1px solid rgba(0,242,254,0.15);
        box-shadow: 0 5px 25px rgba(0,242,254,0.2);
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: #00f2fe;
    }

        .edit-form-container h1 {
            font-weight: 700;
            margin-bottom: 20px;
            text-shadow: 0 0 6px rgba(0,242,254,0.7);
        }

    hr {
        border-color: rgba(0,242,254,0.25);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            font-weight: 600;
            margin-bottom: 6px;
            text-shadow: 0 0 4px rgba(0,242,254,0.6);
        }

    .form-control {
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid rgba(0,242,254,0.25);
        background: rgba(10,15,26,0.85);
        color: #00f2fe;
        transition: 0.25s;
    }

        .form-control:focus {
            border-color: #00f2fe;
            box-shadow: 0 0 10px rgba(0,242,254,0.25);
            outline: none;
        }

    .form-check-label {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        font-weight: 600;
    }

    .form-check-input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #00f2fe;
    }

    input[type="submit"] {
        background: linear-gradient(90deg,#00f2fe,#4facfe);
        color: #0b0f19;
        font-weight: 700;
        padding: 14px 24px;
        border-radius: 10px;
        border: none;
        box-shadow: 0 0 12px rgba(0,242,254,0.3);
        cursor: pointer;
        transition: 0.25s;
    }

        input[type="submit"]:hover {
            transform: scale(1.02);
            box-shadow: 0 0 18px rgba(0,242,254,0.45);
        }
</style>