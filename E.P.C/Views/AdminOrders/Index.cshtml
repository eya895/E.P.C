@model IEnumerable<E.P.C.Models.Order>

@{
    ViewData["Title"] = "All Orders";
    ViewData["FullWidth"] = true;
}

<div class="epc-hero">
    <div class="orders-card">

        <h2 class="orders-title">All Orders</h2>

        @if (!Model.Any())
        {
            <p class="text-center" style="color: #64748b;">No orders have been placed yet.</p>
        }
        else
        {
            <div class="table-wrapper">
                <table class="orders-table">
                    <thead>
                        <tr>
                            <th>Order #</th>
                            <th>User</th>
                            <th>Date</th>
                            <th>Items</th>
                            <th>Total</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var order in Model)
                        {
                            <tr>
                                <td>#@order.Id</td>
                                <td>@order.User.Email</td>
                                <td>@order.OrderDate.ToString("dd/MM/yyyy HH:mm")</td>
                                <td>
                                    @foreach (var item in order.Items)
                                    {
                                        <div class="order-item-line">@item.Product.Description × @item.Quantity</div>
                                    }
                                </td>
                                <td class="total-cell">₪@order.TotalPrice.ToString("N2")</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }

        <div class="orders-footer">
            <a asp-controller="Admin" asp-action="Index" class="neon-btn">
                Back To Dashboard
            </a>
        </div>

    </div>
</div>

<style>
    html, body {
        margin: 0;
        padding: 0;
        height: 100%;
        overflow: hidden;
        background: #0b0f19;
    }

    .epc-hero {
        height: calc(100vh - 90px);
        overflow: auto;
        display: flex;
        align-items: flex-start;
        justify-content: center;
        padding: 2rem 1rem;
        background: radial-gradient(circle at center, #1a2235 0%, #0b0f19 100%);
        color: white;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .orders-card {
        background: rgba(22, 30, 46, 0.95);
        border: 1px solid rgba(0, 242, 254, 0.25);
        border-radius: 20px;
        padding: 2.5rem;
        max-width: 1100px;
        width: 100%;
        box-shadow: 0 25px 60px rgba(0,0,0,0.6);
    }

    .orders-title {
        text-align: center;
        font-weight: 800;
        margin-bottom: 2rem;
        text-shadow: 0 0 12px rgba(0, 242, 254, 0.35);
    }

    .table-wrapper {
        overflow-x: auto;
    }

    .orders-table {
        width: 100%;
        border-collapse: collapse;
    }

        .orders-table th,
        .orders-table td {
            padding: 14px 12px;
            text-align: left;
            vertical-align: top;
        }

        .orders-table thead {
            background: rgba(0, 242, 254, 0.08);
        }

        .orders-table th {
            font-size: 0.85rem;
            letter-spacing: 1px;
            text-transform: uppercase;
            color: #7dd3fc;
        }

        .orders-table tbody tr {
            border-bottom: 1px solid rgba(0, 242, 254, 0.12);
        }

            .orders-table tbody tr:hover {
                background: rgba(0, 242, 254, 0.05);
            }

        .orders-table td {
            color: #e5e7eb;
            font-size: 0.95rem;
        }

    .order-item-line {
        font-size: 0.85rem;
        color: #94a3b8;
        margin-bottom: 2px;
    }

    .total-cell {
        color: #00f2fe;
        font-weight: 800;
        font-size: 1.05rem;
    }

    .orders-footer {
        margin-top: 2rem;
        text-align: center;
    }

    .neon-btn {
        display: inline-block;
        padding: 12px 32px;
        border-radius: 50px;
        background: linear-gradient(90deg, #00f2fe, #4facfe);
        color: #0b0f19;
        font-weight: 900;
        text-decoration: none;
        box-shadow: 0 0 25px rgba(0, 242, 254, 0.45);
        transition: 0.25s ease;
    }

        .neon-btn:hover {
            transform: translateY(-2px) scale(1.05);
            box-shadow: 0 0 40px rgba(0, 242, 254, 0.8);
            color: #0b0f19;
        }
</style>
