@model E.P.C.Models.ShoppingCart

@{
    ViewData["Title"] = "Your Cart";
    ViewData["FullWidth"] = true;
}

<div class="cart-page">
    <div class="container py-5">

        <h2 class="cart-title">🛒 Your Cart</h2>

        @if (!Model.Items.Any())
        {
            <div class="empty-cart">
                <div class="empty-icon">🛒</div>
                <p>Your cart is empty.</p>
                <a asp-controller="Products" asp-action="Index" class="neon-btn">
                    ← Start Shopping
                </a>
            </div>
        }
        else
        {
            <div class="cart-items">
                @foreach (var item in Model.Items)
                {
                    <div class="cart-row">

                        <img src="@item.Product.ImageUrl"
                             class="cart-img"
                             alt="@item.Product.Description" />

                        <div class="cart-info">
                            <div class="cart-name">@item.Product.Description</div>
                            <div class="cart-unit-price">₪@item.Product.Price.ToString("N0") each</div>
                        </div>

                        <div class="cart-qty">
                            <form asp-action="Remove" method="post">
                                <input type="hidden" name="itemId" value="@item.ProductId" />
                                <button class="qty-btn">−</button>
                            </form>

                            <span class="qty-value">@item.Quantity</span>

                            <form asp-action="Add" method="post">
                                <input type="hidden" name="itemId" value="@item.ProductId" />
                                <button class="qty-btn">+</button>
                            </form>
                        </div>

                        <div class="cart-subtotal">
                            ₪@((item.Product.Price * item.Quantity).ToString("N0"))
                        </div>

                        <form asp-action="RemoveAll" method="post" class="cart-remove">
                            <input type="hidden" name="itemId" value="@item.ProductId" />
                            <button class="remove-btn" title="Remove item">✕</button>
                        </form>

                    </div>
                }
            </div>

            <div class="cart-footer">
                <a asp-controller="Products" asp-action="Index" class="ghost-btn">
                    ← Continue Shopping
                </a>

                <div class="cart-total-block">
                    <div class="cart-total-label">Total</div>
                    <div class="cart-total-value">₪@Model.TotalPrice.ToString("N0")</div>
                    <a asp-controller="Checkout" asp-action="Index" class="neon-btn checkout-btn">
                        Proceed to Checkout →
                    </a>
                </div>
            </div>
        }

    </div>
</div>

<style>
    .cart-page {
        min-height: 100vh;
        background: radial-gradient(circle at top, rgba(0,242,254,0.08), transparent 40%), radial-gradient(circle at bottom, rgba(79,172,254,0.06), transparent 50%), radial-gradient(circle at center, #1a2235 0%, #0b0f19 100%);
        color: white;
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .cart-title {
        font-weight: 800;
        margin-bottom: 2rem;
        text-shadow: 0 0 12px rgba(0,242,254,0.4);
    }

    /* ── Empty state ── */
    .empty-cart {
        text-align: center;
        padding: 5rem 2rem;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.2rem;
    }

    .empty-icon {
        font-size: 4rem;
        opacity: 0.4;
    }

    .empty-cart p {
        color: #64748b;
        font-size: 1.1rem;
    }

    /* ── Cart rows ── */
    .cart-items {
        display: flex;
        flex-direction: column;
        gap: 14px;
        margin-bottom: 2.5rem;
    }

    .cart-row {
        display: flex;
        align-items: center;
        gap: 20px;
        background: rgba(22,30,46,0.95);
        border: 1px solid rgba(0,242,254,0.18);
        border-radius: 16px;
        padding: 16px 20px;
        transition: 0.25s ease;
    }

        .cart-row:hover {
            border-color: rgba(0,242,254,0.4);
            box-shadow: 0 8px 30px rgba(0,242,254,0.1);
        }

    .cart-img {
        width: 72px;
        height: 72px;
        object-fit: contain;
        border-radius: 10px;
        background: rgba(0,0,0,0.3);
        padding: 4px;
        flex-shrink: 0;
    }

    .cart-info {
        flex: 1;
        min-width: 0;
    }

    .cart-name {
        font-weight: 700;
        font-size: 0.95rem;
        color: #e2e8f0;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }

    .cart-unit-price {
        font-size: 0.8rem;
        color: #64748b;
        margin-top: 4px;
    }

    /* ── Quantity controls ── */
    .cart-qty {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-shrink: 0;
    }

    .qty-btn {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        border: 1px solid rgba(0,242,254,0.4);
        background: rgba(0,242,254,0.08);
        color: #00f2fe;
        font-size: 1.1rem;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .qty-btn:hover {
            background: rgba(0,242,254,0.22);
            box-shadow: 0 0 12px rgba(0,242,254,0.35);
        }

    .qty-value {
        font-weight: 800;
        font-size: 1rem;
        color: #e2e8f0;
        min-width: 24px;
        text-align: center;
    }

    /* ── Subtotal ── */
    .cart-subtotal {
        font-weight: 800;
        font-size: 1rem;
        color: #00f2fe;
        min-width: 90px;
        text-align: right;
        flex-shrink: 0;
    }

    /* ── Remove button ── */
    .cart-remove {
        flex-shrink: 0;
    }

    .remove-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid rgba(239,68,68,0.4);
        background: rgba(239,68,68,0.08);
        color: #f87171;
        font-size: 0.85rem;
        cursor: pointer;
        transition: 0.2s ease;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .remove-btn:hover {
            background: rgba(239,68,68,0.25);
            box-shadow: 0 0 12px rgba(239,68,68,0.35);
        }

    /* ── Footer ── */
    .cart-footer {
        display: flex;
        justify-content: space-between;
        align-items: flex-end;
        flex-wrap: wrap;
        gap: 1.5rem;
        padding-top: 1.5rem;
        border-top: 1px solid rgba(0,242,254,0.12);
    }

    .cart-total-block {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
    }

    .cart-total-label {
        font-size: 0.85rem;
        color: #64748b;
        text-transform: uppercase;
        letter-spacing: 1px;
    }

    .cart-total-value {
        font-size: 2rem;
        font-weight: 900;
        color: #00f2fe;
        text-shadow: 0 0 14px rgba(0,242,254,0.5);
    }

    /* ── Buttons ── */
    .neon-btn {
        display: inline-block;
        padding: 13px 30px;
        border-radius: 50px;
        background: linear-gradient(90deg, #00f2fe, #4facfe);
        color: #0b0f19;
        font-weight: 900;
        text-decoration: none;
        box-shadow: 0 0 25px rgba(0,242,254,0.4);
        transition: 0.25s ease;
        white-space: nowrap;
    }

        .neon-btn:hover {
            transform: translateY(-2px) scale(1.04);
            box-shadow: 0 0 40px rgba(0,242,254,0.7);
            color: #0b0f19;
        }

    .checkout-btn {
        font-size: 1rem;
    }

    .ghost-btn {
        display: inline-block;
        padding: 13px 30px;
        border-radius: 50px;
        border: 1px solid rgba(0,242,254,0.35);
        background: rgba(0,242,254,0.07);
        color: #00f2fe;
        font-weight: 700;
        text-decoration: none;
        transition: 0.25s ease;
        white-space: nowrap;
    }

        .ghost-btn:hover {
            background: rgba(0,242,254,0.15);
            box-shadow: 0 0 16px rgba(0,242,254,0.25);
            color: #00f2fe;
        }
</style>