@model E.P.C.Models.GPU

@{
    ViewData["Title"] = "Create";
}

<h1>Create</h1>

<h4>GPU</h4>
<hr />
<div class="create-form-container">
    
        <form asp-action="Create">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>
        <div class="form-grid">
            <div class="form-group socket-group">
                <label>Brand</label>

                <div class="socket-checkboxes">
                    @{
                        var brands = new List<string>
                                        {"Nvidia","AMD","Intel"};
                    }

                    @foreach (var brand in brands)
                    {
                        <label class="socket-label">
                            <input asp-for="Brand"
                                   type="radio"
                                   value="@brand" />
                            <span>@brand</span>
                        </label>
                    }
                </div>

                <span asp-validation-for="Brand" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Model" class="control-label"></label>
                <input asp-for="Model" class="form-control" />
                <span asp-validation-for="Model" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MemorySize" class="control-label">Memory Size(In Gb):</label>
                <input asp-for="MemorySize" class="form-control" />
                <span asp-validation-for="MemorySize" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="MemoryType" class="control-label">Memory Type:</label>
                <input asp-for="MemoryType" class="form-control" />
                <span asp-validation-for="MemoryType" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="CoreClock" class="control-label"></label>
                <input asp-for="CoreClock" class="form-control" />
                <span asp-validation-for="CoreClock" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="BoostClock" class="control-label"></label>
                <input asp-for="BoostClock" class="form-control" />
                <span asp-validation-for="BoostClock" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="TDP" class="control-label">Thermal Design Power</label>
                <input asp-for="TDP" class="form-control" />
                <span asp-validation-for="TDP" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Interface" class="control-label"></label>
                <input asp-for="Interface" class="form-control" />
                <span asp-validation-for="Interface" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="dimensions" class="control-label"></label>
                <input asp-for="dimensions" class="form-control" />
                <span asp-validation-for="dimensions" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Ports" class="control-label"></label>
                <input asp-for="Ports" class="form-control" />
                <span asp-validation-for="Ports" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Description" class="control-label"></label>
                <input asp-for="Description" class="form-control" />
                <span asp-validation-for="Description" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="Price" class="control-label"></label>
                <input asp-for="Price" class="form-control" />
                <span asp-validation-for="Price" class="text-danger"></span>
            </div>
            <div class="form-group">
                <label asp-for="ImageUrl" class="control-label"></label>
                <input asp-for="ImageUrl" class="form-control" />
                <span asp-validation-for="ImageUrl" class="text-danger"></span>
            </div>
        </div>
            <div class="form-group">
                <input type="submit" value="Create" class="btn btn-primary" />
            </div>
        </form>
    </div>

<a asp-controller="Products"
   asp-action="Index"
   class="hero-btn">
    Back To Product List
</a>
@section Scripts {
    @{await Html.RenderPartialAsync("_ValidationScriptsPartial");}
}

<style>
    .create-form-container {
        max-width: 1200px;
        margin: 40px auto;
        padding: 40px;
        background: rgba(10,15,26,0.95);
        border-radius: 18px;
        border: 1px solid rgba(0,242,254,0.15);
        box-shadow: 0 5px 25px rgba(0,242,254,0.2);
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
        color: #00f2fe;
    }

        .create-form-container h1 {
            font-weight: 700;
            margin-bottom: 20px;
            text-shadow: 0 0 6px rgba(0,242,254,0.7);
        }

    hr {
        border-color: rgba(0,242,254,0.25);
    }

    .form-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit,minmax(280px,1fr));
        gap: 20px;
    }

    .form-group {
        display: flex;
        flex-direction: column;
    }

        .form-group label {
            font-weight: 600;
            margin-bottom: 6px;
            text-shadow: 0 0 4px rgba(0,242,254,0.6);
        }

    .form-control {
        padding: 10px 12px;
        border-radius: 8px;
        border: 1px solid rgba(0,242,254,0.25);
        background: rgba(10,15,26,0.85);
        color: #00f2fe;
        transition: 0.25s;
    }

        .form-control:focus {
            border-color: #00f2fe;
            box-shadow: 0 0 10px rgba(0,242,254,0.25);
            outline: none;
        }

    .form-check-label {
        display: flex;
        align-items: center;
        gap: 10px;
        cursor: pointer;
        font-weight: 600;
    }

    .form-check-input {
        width: 18px;
        height: 18px;
        cursor: pointer;
        accent-color: #00f2fe;
    }

    input[type="submit"] {
        background: linear-gradient(90deg,#00f2fe,#4facfe);
        color: #0b0f19;
        font-weight: 700;
        padding: 14px 24px;
        border-radius: 10px;
        border: none;
        box-shadow: 0 0 12px rgba(0,242,254,0.3);
        cursor: pointer;
        transition: 0.25s;
    }

        input[type="submit"]:hover {
            transform: scale(1.02);
            box-shadow: 0 0 18px rgba(0,242,254,0.45);
        }
    /* ---------- SOCKET SELECTOR ---------- */

    .socket-group {
        grid-column: 1 / -1;
    }

    .socket-checkboxes {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 10px;
    }

    .socket-label {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 130px;
        padding: 10px 18px;
        border-radius: 20px;
        background: rgba(10,15,26,0.85);
        border: 2px solid rgba(0,242,254,0.25);
        color: #00f2fe;
        font-weight: 700;
        cursor: pointer;
        transition: all .25s ease;
        box-shadow: 0 4px 12px rgba(0,242,254,0.15);
    }

        .socket-label input[type="radio"] {
            display: none;
        }

        .socket-label span {
            display: block;
            width: 100%;
            text-align: center;
            border-radius: 20px;
            padding: 8px 12px;
            transition: all .25s ease;
        }

        .socket-label input[type="radio"]:checked + span {
            background: linear-gradient(90deg,#00f2fe,#4facfe);
            color: #0b0f19;
            box-shadow: 0 0 15px rgba(0,242,254,.7), inset 0 0 25px rgba(0,242,254,.3);
        }

        .socket-label:hover {
            transform: translateY(-2px);
            box-shadow: 0 4px 14px rgba(0,242,254,.35);
        }
</style>