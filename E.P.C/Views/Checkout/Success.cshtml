@{
    ViewData["Title"] = "Order Placed";
    ViewData["FullWidth"] = true;
}

<div class="success-page">
    <div class="success-card">

        <div class="success-icon">🎉</div>
        <h1 class="success-title">Order Placed!</h1>
        <p class="success-msg">Thank you for your purchase. Your components are on their way!</p>

        <div class="success-actions">
            <a asp-controller="Products" asp-action="Index" class="neon-btn">
                Continue Shopping
            </a>
        </div>

    </div>
</div>

<style>
    .success-page {
        min-height: calc(100vh - 90px);
        display: flex;
        align-items: center;
        justify-content: center;
        background: radial-gradient(circle at top, rgba(0,242,254,0.08), transparent 40%), radial-gradient(circle at bottom, rgba(79,172,254,0.06), transparent 50%), radial-gradient(circle at center, #1a2235 0%, #0b0f19 100%);
        font-family: 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
    }

    .success-card {
        background: rgba(22,30,46,0.95);
        border: 1px solid rgba(0,242,254,0.25);
        border-radius: 24px;
        padding: 3.5rem 3rem;
        max-width: 480px;
        width: 100%;
        text-align: center;
        box-shadow: 0 0 60px rgba(0,242,254,0.15), 0 30px 60px rgba(0,0,0,0.6);
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 1.2rem;
    }

    .success-icon {
        font-size: 4rem;
        filter: drop-shadow(0 0 16px rgba(0,242,254,0.5));
    }

    .success-title {
        font-size: 2rem;
        font-weight: 900;
        color: #fff;
        text-shadow: 0 0 14px rgba(0,242,254,0.5);
        margin: 0;
    }

    .success-msg {
        color: #94a3b8;
        font-size: 1rem;
        line-height: 1.6;
        margin: 0;
    }

    .success-actions {
        margin-top: 0.5rem;
    }

    .neon-btn {
        display: inline-block;
        padding: 14px 36px;
        border-radius: 50px;
        background: linear-gradient(90deg, #00f2fe, #4facfe);
        color: #0b0f19;
        font-weight: 900;
        font-size: 1rem;
        text-decoration: none;
        box-shadow: 0 0 25px rgba(0,242,254,0.4);
        transition: 0.25s ease;
    }

        .neon-btn:hover {
            transform: translateY(-2px) scale(1.04);
            box-shadow: 0 0 40px rgba(0,242,254,0.7);
            color: #0b0f19;
        }
</style>